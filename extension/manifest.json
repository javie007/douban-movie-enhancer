{
  "manifest_version": 3,
  "name": "豆瓣选电影增强",
  "version": "1.0.0",
  "description": "在豆瓣电影“选电影”页面补充缺失的“剧情”类型筛选。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://movie.douban.com/explore*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
